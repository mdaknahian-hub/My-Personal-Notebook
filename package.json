    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts",
    "setup": "tsx scripts/seed.ts",
    "icons": "node scripts/generate-icons.mjs",
    "pwa:check": "node scripts/pwa-check.mjs"
  },
  "dependencies": {
